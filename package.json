{
  "name": "opencart_framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:smoke:sanity": "playwright test --grep \"@smoke|@sanity\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:headed:all": "playwright test --headed",
    "report:html": "playwright show-report"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "csv-parse": "^7.0.1",
    "luxon": "^3.7.2",
    "xlsx": "^0.18.5"
  }
}
